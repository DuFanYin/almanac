# The repository's settings, read by src/llm/config.py. Copy to .env (mode 600, never in git); a variable set in the
# environment wins over this file.

# The model provider: "deepseek", "openai" or "openrouter"
LLM_PROVIDER=deepseek

# Its API key (deepseek: sk-..., from https://platform.deepseek.com/api_keys)
LLM_API_KEY=your_llm_api_key_here

# Optional: Tavily's search for research (src/research/sources.py); without it research reads Google News only
# TAVILY_API_KEY=tvly-...
